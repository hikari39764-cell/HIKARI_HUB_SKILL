        {
          "key": "branch",
          "type": "text",
          "ja": "ブランチ",
          "zh": "分支"
        },
        {
          "key": "pr",
          "type": "text",
          "ja": "PR",
          "zh": "PR",
          "help": "URL か番号"
        },
        {
          "key": "bug",
          "type": "ref",
          "ref": "bugs",
          "ja": "元の不具合",
          "zh": "来源 bug"
        },
        {
          "key": "started_at",
          "type": "time",
          "ja": "着手",
          "zh": "开工"
        }
