        },
        {
          "key": "waiting",
          "type": "choice",
          "choices": [
            "決定",
            "レビュー",
            "検収"
          ],
          "ja": "何を待つか",
          "zh": "等什么",
          "help": "state が 確認待ち のとき"
        },
        {
          "key": "assignee",
          "type": "member",
          "ja": "担当",
          "zh": "担当",
          "help": "作業中・確認待ちのときにやっている人"
