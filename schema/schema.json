    {
      "key": "guides",
      "prefix": "g",
      "writer": "member",
      "label": {
        "ja": "調整ガイド",
        "zh": "调整指南"
      },
      "summary": {
        "ja": "作った機能を、人があとから調整できるようにする案内。機能ごとに 1 つ：エディタで変えられる値と、コードで微調整するところ。エージェントは機能を作る・変えるたびに必ず書く。",
        "zh": "让人事后能调整已做功能的说明。每个功能一条：编辑器里能改的值、要通过代码微调的位置。智能体每次新做或改动功能都必须写。"
      },
      "states": [
        {
          "name": "有効",
          "open": true,
          "zh": "有效"
        },
        {
          "name": "古い",
          "open": false,
          "zh": "已过时"
        }
