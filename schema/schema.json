        "ja": "カード",
        "zh": "任务卡"
      },
      "summary": {
        "ja": "作業の単位。何をやるかは各自が決めてよい：自分で作って、自分で始める。オーナーの「予定」は、おすすめの順番。",
        "zh": "工作单位。做什么由各人自己定：自己建、自己开工。所有者的“预定”只是建议的顺序。"
      },
      "states": [
        {
          "name": "あとで",
          "open": true,
          "zh": "以后"
        },
        {
          "name": "作業中",
          "open": true,
          "zh": "进行中"
        },
        {
          "name": "確認待ち",
          "open": true,
          "zh": "等确认"
        },
        {
          "name": "完了",
          "open": false,
          "zh": "完成"
        },
        {
          "name": "やらない",
          "open": false,
          "zh": "不做"
        }
      ],
      "fields": [
        {
          "key": "title",
          "type": "text",
          "required": true,
          "ja": "名前",
          "zh": "名字",
          "help": "何ができるようになるかを短く（例「敵のノックバック」）"
        },
        {
          "key": "kind",
          "type": "choice",
          "choices": [
            "機能",
            "修正",
            "素材",
            "レベル",
            "調整",
            "調査"
          ],
          "ja": "種類",
          "zh": "种类"
        },
        {
          "key": "summary",
          "type": "longtext",
          "ja": "何をするか",
          "zh": "做什么"
        },
        {
          "key": "acceptance",
          "type": "list",
          "ja": "完了条件",
          "zh": "怎样算完成",
          "help": "1 行に 1 つ"
        },
        {
          "key": "paths",
          "type": "list",
          "ja": "関連ファイル",
          "zh": "相关文件",
          "help": "触りそうなファイル・フォルダ・シーン。1 行に 1 つ。ぶつかり予報に使う"
        },
        {
          "key": "areas",
          "type": "areas",
          "ja": "領域",
          "zh": "领域"
        },
        {
          "key": "budget_hours",
          "type": "number",
