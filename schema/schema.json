    "by_agent": {
      "ja": "エージェント",
      "zh": "智能体",
      "help": "エージェントが書いたときだけ。例 claude-code。人がページで書いたときは空"
    },
    "at": {
      "ja": "作成",
      "zh": "创建",
      "help": "ISO 8601（例 2026-11-10T13:05:00+09:00）"
    },
    "updated_at": {
      "ja": "更新",
      "zh": "更新",
      "help": "ISO 8601"
    },
    "updated_by": {
      "ja": "更新した人",
      "zh": "谁更新的",
      "help": "呼び名"
    }
  },
