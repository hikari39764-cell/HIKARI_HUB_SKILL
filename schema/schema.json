      "label": {
        "ja": "ミス帳",
        "zh": "错误簿"
      },
      "summary": {
        "ja": "やってしまった間違い。同じ領域・ファイルで作業する人の簡報に出る。",
        "zh": "犯过的错。在同一领域、同一文件干活的人会在简报里看到。"
